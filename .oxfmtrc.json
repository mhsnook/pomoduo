{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 90,
  "sortImports": true,
  "ignorePatterns": [
    "worker-configuration.d.ts",
    "dist/**",
    "prototypes/**",
    "pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,css,html}"],
      "options": { "useTabs": true }
    }
  ]
}
